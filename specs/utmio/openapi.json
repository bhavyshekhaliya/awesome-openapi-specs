    "/links": {
      "get": {
        "summary": "Returns the list of the links",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "workspace",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "workspace slug"
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "search by"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "string"
            },
            "description": "Page"
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "string"
            },
            "description": "Page size"
          },
          {
            "in": "query",
            "name": "startDate",
            "schema": {
              "type": "date"
            },
            "description": "Start date"
          },
          {
            "in": "query",
            "name": "endDate",
            "schema": {
              "type": "date"
            },
            "description": "End date"
          }
        ],
        "responses": {
          "200": {
            "description": "The list of the links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "SUCCESS"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Link"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "number",
                          "description": "Total matching records. OMITTED ENTIRELY on very large workspaces, where the total cannot be derived from an index. Treat a missing `total` as unknown and page until a page returns fewer items than `pageSize` — do not treat it as zero."
                        },
                        "currentPage": {
                          "type": "number"
                        },
                        "pageSize": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create links",
        "tags": [
          "Links"
        ],
